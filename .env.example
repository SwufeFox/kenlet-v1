# ===========================================================================
# kenlet-v1 环境变量
# 复制为 .env 后填写
# ===========================================================================

# Binance (数据源, 公共行情可留空)
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# 测试网 (实盘测试用)
BINANCE_TESTNET=true

# 合约模式 (可选; 仅影响数据源选择, 本系统不下真实订单)
# BINANCE_FUTURES=false

# Layer 3 — LLM Fund Manager (可选, DeepSeek 默认)
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# 日志级别 (可选)
# KENLET_LOG_LEVEL=DEBUG
